4.Array_Methods_(map, filter, reduce).js

let numbers = [10, 20, 30, 40, 50];

// map()
let doubled = numbers.map(num => num * 2);

console.log("Doubled Array:");
console.log(doubled);

// filter()
let greaterThan25 = numbers.filter(num => num > 25);

console.log("\nNumbers Greater than 25:");
console.log(greaterThan25);

// reduce()
let sum = numbers.reduce((total, num) => total + num, 0);

console.log("\nSum of Elements:");
console.log(sum);



