6.Combining_Functions, Arrays, and Objects.js

// Array of Objects
let students = [
    {name: "Rahul", marks: 85},
    {name: "Priya", marks: 92},
    {name: "Amit", marks: 78},
    {name: "Sneha", marks: 88}
];

// Function to Display Students
function displayStudents(studentArray) {
    console.log("Student Details:\n");

    studentArray.forEach(student => {
        console.log(`${student.name} scored ${student.marks} marks.`);
    });
}

// Function to Calculate Average Marks
function calculateAverage(studentArray) {

    let total = studentArray.reduce((sum, student) => sum + student.marks, 0);

    return total / studentArray.length;
}

// Function Calls
displayStudents(students);

console.log("\nAverage Marks:", calculateAverage(students));


pact 6

Step 1: Set Up Your Project Folder
1.	Create a new folder on your desktop, e.g. express-practical
2.	Open VS Code
3.	Go to File → Open Folder and select express-practical
4.	Open the built-in terminal: Terminal → New Terminal (or Ctrl + `)

Step 2: Initialize the Node Project
In the VS Code terminal, run:
bash
npm init -y
This creates a package.json file with default settings.

Step 3: Install Express
bash
npm install express
This downloads Express into a node_modules folder and adds it as a dependency in package.json.

Step 4: Create the Server File
In VS Code, create a new file called index.js (click New File icon in Explorer).

Step 5: Write the Server Code
Paste this into index.js:
javascript

const express = require('express');
const app = express();
const PORT = 3000;

app.get('/', (req, res) => {
  console.log('Home route was accessed');
  res.send('<h1>Welcome to my Express Server!</h1>');
});

app.get('/about', (req, res) => {
  console.log('About route was accessed');
  res.send('<h2>This is the About Page</h2>');
});

app.get('/api/data', (req, res) => {
  console.log('API data route was accessed');
  res.json({
    name: 'Student',
    course: 'Node.js and Express',
    status: 'Learning Successful'
  });
});

app.get('/contact', (req, res) => {
  console.log('Contact route was accessed');
  res.send('Contact us at: example@email.com');
});

app.listen(PORT, () => {
  console.log(`Server is running successfully on http://localhost:${PORT}`);
});


Step 6: Run the Server
In the terminal, run:
bash
node index.js
You should see this in the VS Code console/terminal:
Server is running successfully on http://localhost:3000
(Keep this terminal running — don't close it.)

Step 7: Test Routes in the Browser
Open your browser and visit each route one by one:
URL	Expected Output
http://localhost:3000/	"Welcome to my Express Server!"
http://localhost:3000/about	"This is the About Page"
http://localhost:3000/api/data	JSON object with name, course, status
http://localhost:3000/contact	"Contact us at: example@email.com"






